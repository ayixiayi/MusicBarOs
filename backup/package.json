{
  "name": "gesture-control-v1",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "基于MediaPipe的手势音量控制器",
  "author": "Bao Jinming",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.bao.gesturecontrol",
    "productName": "GestureControl",
    "copyright": "Copyright © 2025 Bao Jinming",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "react-dom": "^19.2.1",
    "@google/genai": "^1.31.0",
    "@mediapipe/tasks-vision": "0.10.3",
    "three": "0.160.0",
    "loudness": "^0.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}